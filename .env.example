NODE_ENV=production
NEXT_PUBLIC_APP_NAME=Vapor Entregas
NEXT_PUBLIC_APP_URL=https://vaporentregaspnz.com
TZ=America/Recife

# Pré-lançamento: em produção, defina true para expor somente a captação pública.
PRELAUNCH_MODE=true
# UUIDs internos autenticados, separados por vírgula. Vazio libera apenas ADMIN.
PRELAUNCH_TEST_USER_IDS=

# MySQL 8.0.16+; codifique usuário/senha para URL quando houver caracteres especiais.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"
# Opcional e exclusivamente para `npm run test:mysql`; nunca aponte para produção.
MYSQL_TEST_DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/vapor_mysql_test"
AUTH_RATE_LIMIT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_FORTE
SESSION_TTL_DAYS=7
FIELD_ENCRYPTION_KEY=SUBSTITUA_POR_UMA_CHAVE_BASE64_DE_32_BYTES

ADMIN_NAME=Administrador Vapor Entregas
ADMIN_EMAIL=SUBSTITUA_PELO_EMAIL_ADMINISTRATIVO
ADMIN_PHONE=+5587999999999
ADMIN_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE

NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
GEOCODING_PROVIDER=nominatim
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=VaporEntregas/1.0 (SUBSTITUA_POR_UM_CONTATO_REAL)
GEOCODING_CACHE_TTL_SECONDS=86400
DISTANCE_PROVIDER=straight_line
GOOGLE_MAPS_API_KEY=SUBSTITUA_PELA_CHAVE
GOOGLE_ROUTES_API_BASE_URL=https://routes.googleapis.com
GOOGLE_ROUTES_TIMEOUT_MS=2500
ROUTE_CACHE_TTL_SECONDS=180

# Payment Brick: pagamento avulso de 30 dias. Veja docs/mercado-pago-payments.md.
# Public Key e Access Token devem ser da mesma aplicação e ambiente.
MERCADO_PAGO_MODE=test
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=SUBSTITUA_PELA_PUBLIC_KEY_DE_TESTE
MERCADO_PAGO_ACCESS_TOKEN=SUBSTITUA_PELO_ACCESS_TOKEN_DE_TESTE
MERCADO_PAGO_WEBHOOK_SECRET=SUBSTITUA_PELA_ASSINATURA_SECRETA_DO_WEBHOOK
MERCADO_PAGO_API_BASE_URL=https://api.mercadopago.com

ONLINE_PRESENCE_TTL_MINUTES=10
PRESENCE_LOCATION_MIN_INTERVAL_SECONDS=30
