{
  "name": "vapor-entregas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plataforma local de intermediação tecnológica entre empresas e motoboys independentes.",
  "engines": {
    "node": ">=22 <23"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "mariadb": "3.5.3"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:mysql": "vitest run --config vitest.mysql.config.ts",
    "test:watch": "vitest",
    "format:check": "prettier . --check",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "leaflet": "^1.9.4",
    "mariadb": "3.5.3",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
